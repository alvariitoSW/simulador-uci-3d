config_version=5

[application]

config/name="Simulador UCI 3D - Prototipo Arsenal Farmacologico"
config/description="Prototipo: minijuego de disparo tactico en el que el arma equipada representa el antibiotico elegido. Acertar la cobertura correcta contra cada microorganismo da un arma potente y precisa; equivocarse da un arma debil que apenas hace dano y perjudica al paciente."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.42, 0.58, 0.55, 1)

[autoload]

GameManager="*res://scripts/game_manager.gd"
